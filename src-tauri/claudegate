#!/bin/sh
# claudegate [PATH]: open ClaudeGate Desktop on the project that owns PATH (default: the current directory).
target=${1:-$PWD}
case $target in
  /*) ;;
  *) target=$PWD/$target ;;
esac
if [ ! -x /usr/bin/claudegate-desktop ]; then
  echo "claudegate: /usr/bin/claudegate-desktop is not installed or not executable" >&2
  exit 127
fi
# Detached, so the terminal returns at once; output goes nowhere.
setsid nohup /usr/bin/claudegate-desktop "$target" >/dev/null 2>&1 </dev/null &
